{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "adb-tv-studio",
  "version": "../package.json",
  "identifier": "lol.develover.adbtvstudio",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ADB TV Studio",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "decorations": false,
        "backgroundColor": "#0E110F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/adb"],
    "resources": {
      "binaries/scrcpy-server.jar": "scrcpy-server.jar",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "themes/": "themes/",
      "launcher/": "launcher/"
    },
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "category": "Utility",
    "shortDescription": "Manage Android TV devices over ADB",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/develoverli/adb-tv-studio/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0MTVEQTkzRjQ1M0ExNTQKUldSVW9WUDBrOW9WdE1SWFN0Z2JjajYzVTBHQ1lScy9PYXRCNGtwQ2JEamlSQUVMRWJmd20yZEoK"
    }
  }
}
